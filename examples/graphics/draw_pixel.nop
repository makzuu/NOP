jmp __START

GET_VALUE:
read
pop acc
ret

SET_X:
call GET_VALUE
mov acc, bp(0)
ret

SET_Y:
call GET_VALUE
mov acc, bp(1)
ret

SET_COLOR:
call GET_VALUE
mov acc, bp(2)
ret

CONTINUE:
call GET_VALUE
ret

__START:
push 0
push 0
push 3
push -1

MAIN_LOOP:
call SET_X
call SET_Y
call SET_COLOR
draw
call CONTINUE
jez END_PROGRAM
jmp MAIN_LOOP

END_PROGRAM:
